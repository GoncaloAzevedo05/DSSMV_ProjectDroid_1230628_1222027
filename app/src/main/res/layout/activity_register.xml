<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/main_register"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212"
            android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

        <!-- Logo -->
        <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="SoundDroid Logo"
                android:src="@android:drawable/ic_media_play"
                app:tint="#1DB954" />

        <!-- Título -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="Criar Conta"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="Junta-te ao SoundDroid"
                android:textColor="#B3B3B3"
                android:textSize="14sp" />

        <!-- Campo Nome de Utilizador -->
        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColorHint="#B3B3B3"
                app:boxBackgroundColor="#282828"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1DB954"
                app:hintTextColor="#1DB954"
                app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                app:startIconTint="#B3B3B3">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome de utilizador"
                    android:inputType="textPersonName"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Email -->
        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColorHint="#B3B3B3"
                app:boxBackgroundColor="#282828"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1DB954"
                app:hintTextColor="#1DB954"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="#B3B3B3">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Password -->
        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColorHint="#B3B3B3"
                app:boxBackgroundColor="#282828"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1DB954"
                app:endIconMode="password_toggle"
                app:endIconTint="#B3B3B3"
                app:hintTextColor="#1DB954"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="#B3B3B3">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password (6-16 caracteres)"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Confirmar Password -->
        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:textColorHint="#B3B3B3"
                app:boxBackgroundColor="#282828"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1DB954"
                app:endIconMode="password_toggle"
                app:endIconTint="#B3B3B3"
                app:hintTextColor="#1DB954"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="#B3B3B3">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Confirmar password"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Indicador de Carregamento -->
        <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="#1DB954"
                android:visibility="gone" />

        <!-- Botão Registar -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:text="Criar Conta"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1DB954"
                app:cornerRadius="28dp" />

        <!-- Voltar ao Login -->
        <TextView
                android:id="@+id/txtLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Já tens conta? Entra aqui"
                android:textColor="#B3B3B3"
                android:textSize="14sp"
                android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/main_settings"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/background_color"
              android:gravity="center_horizontal"
              android:orientation="vertical"
              android:padding="24dp">

    <androidx.cardview.widget.CardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#282828"
            app:cardCornerRadius="55dp"
            app:cardElevation="6dp">

        <ImageView
                android:id="@+id/imgProfilePicture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto de Perfil"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#B3B3B3" />
    </androidx.cardview.widget.CardView>

    <TextView
            android:id="@+id/txtUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.01"
            android:text="Nome do Utilizador"
            android:textColor="@color/text_color"
            android:textSize="22sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/txtUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="utilizador@email.com"
            android:textColor="#B3B3B3"
            android:textSize="14sp" />

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:background="#282828" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccountInfo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Account info"
            android:textAlignment="viewStart"
            android:textColor="@color/text_color"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="#1DB954"
            app:strokeColor="#282828"
            app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavoriteSongs"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Favorites"
            android:textAlignment="viewStart"
            android:textColor="@color/text_color"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/btn_star"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="#1DB954"
            app:strokeColor="#282828"
            app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopArtist"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Most Listen"
            android:textAlignment="viewStart"
            android:textColor="@color/text_color"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="#1DB954"
            app:strokeColor="#282828"
            app:strokeWidth="1dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/btnSwitchMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo Escuro"
            android:textColor="@color/text_color" />

    <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Logout"
            android:textColor="@color/text_color"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#E50914"
            app:cornerRadius="26dp"
            app:icon="@android:drawable/ic_lock_power_off"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadedMusic"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="Downloaded Music"
            android:textColor="@color/text_color"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#282828" />

</LinearLayout>
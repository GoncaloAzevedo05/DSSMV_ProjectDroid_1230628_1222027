<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/main_login"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="#121212"
              android:gravity="center"
              android:orientation="vertical"
              android:padding="28dp">

    <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="SoundDroid Logo"
            android:src="@android:drawable/ic_media_play"
            app:tint="#1DB954" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="SoundDroid"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Música sem limites"
            android:textColor="#B3B3B3"
            android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColorHint="#B3B3B3"
            app:boxBackgroundColor="#282828"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#1DB954"
            app:hintTextColor="#1DB954"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#B3B3B3">

        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColorHint="#B3B3B3"
            app:boxBackgroundColor="#282828"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#1DB954"
            app:endIconMode="password_toggle"
            app:endIconTint="#B3B3B3"
            app:hintTextColor="#1DB954"
            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
            app:startIconTint="#B3B3B3">

        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password (6-16 caracteres)"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
            android:id="@+id/txtForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="24dp"
            android:padding="4dp"
            android:text="Esqueceste-te da palavra-passe?"
            android:textColor="#1DB954"
            android:textSize="13sp"
            android:textStyle="bold" />

    <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="#1DB954"
            android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:text="Entrar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#1DB954"
            app:cornerRadius="28dp" />

    <TextView
            android:id="@+id/txtRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Não tens conta? Regista-te aqui"
            android:textColor="#B3B3B3"
            android:textSize="14sp"
            android:textStyle="bold" />

</LinearLayout>